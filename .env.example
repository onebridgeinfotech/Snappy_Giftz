# ===================================================
# Snappy Gifts — Environment Variable Configuration
# IMPORTANT: Never commit real secrets or production keys.
# Copy this file to .env for local development / Hostinger deployment.
# ===================================================

# Application Environment
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Target MySQL Database (Hostinger / Local MySQL 8+)
# Hostinger Remote MySQL port is strictly 3306
DATABASE_URL="mysql://u285517860_snappyadmin:YOUR_MYSQL_PASSWORD@srv2204.hstgr.io:3306/u285517860_snappygiftz"
DIRECT_URL="postgresql://snappy_user:snappy_dev_password_only@localhost:5432/snappy_gifts_db?schema=public"

# Auth.js / NextAuth Session Secret (Generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET="dev_insecure_secret_for_local_development_only_replace_in_prod"
NEXTAUTH_URL="http://localhost:3000"

# Protected Administrator Account
ADMIN_EMAIL="phoenixnot13@gmail.com"
# ADMIN_BOOTSTRAP_PASSWORD="YourSecureAdminPassword123"

# Razorpay Payment Gateway — exact names required on Hostinger (no quotes in hPanel values)
# Dashboard: Settings → API Keys (Key ID + Key Secret)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_api_secret_from_razorpay"
# Webhooks only (checkout works without this; add for payment.captured events):
# Dashboard: Settings → Webhooks → secret for https://snappygiftz.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# Transactional Email (Hostinger Titan / Custom SMTP / Mailpit)
# For Hostinger Titan: smtp.hostinger.com (Port 465 with SSL, or 587 with STARTTLS)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="orders@snappygiftz.com"
SMTP_PASSWORD="YOUR_HOSTINGER_EMAIL_PASSWORD"
SMTP_FROM_EMAIL="orders@snappygiftz.com"
SMTP_FROM_NAME="SNAPPY GIFTZ"
EMAIL_FROM="orders@snappygiftz.com"
# Send outbox emails immediately after enqueue (set false to use cron/admin process only)
EMAIL_AUTO_DISPATCH="true"
# Comma-separated admin alert inboxes (defaults include phoenix + onebridge in business config)
ADMIN_EMAILS="phoenixnot13@gmail.com,onebridgeinfotech@gmail.com"

# Meta WhatsApp Cloud API (optional — floating wa.me button works without this)
WHATSAPP_GRAPH_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_ADMIN_NOTIFY_PHONE="8309600721"
WHATSAPP_LOCAL_MOCK="false"

# Internal Security & Worker Crons
CRON_SECRET="snappy_cron_secret_worker_64char_key"
INTERNAL_WORKER_SECRET="snappy_internal_worker_secret_key"

# Secure Private File Storage (Local Disk / S3 / Cloudflare R2)
STORAGE_PROVIDER="local" # "local" for dev/Hostinger disk, "s3" for AWS S3/R2
STORAGE_BUCKET="snappy-gifts-private-uploads"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="ap-south-1"
STORAGE_ENDPOINT=""

# Personalization & Packaging Surcharges (Integer Paise: 100 paise = ₹1.00)
# Default for Vintage Wooden Keepsake Crate: 15000 paise (₹150.00)
# Set to 'true' only after formal store owner written approval
WOODEN_CRATE_SURCHARGE_PAISE="15000"
WOODEN_CRATE_SURCHARGE_APPROVED="false"
NEXT_PUBLIC_WOODEN_CRATE_SURCHARGE_APPROVED="false"

# Distributed Rate Limiting & Abuse Prevention (Upstash Redis)
# In dev/single-node, defaults to memory adapter; upstash for serverless clusters
RATE_LIMIT_BACKEND="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional GSTIN override (if different from database seller configuration)
SELLER_GSTIN=""

# ===================================================
# Google OAuth & Customer Authentication
# ===================================================
# Web application client credentials from Google Cloud Console ("SNAPPY GIFTZ PRODUCTION")
# Authorized redirect URIs:
#   Customer Sign-In: https://snappygiftz.com/api/auth/google/callback
#   Drive Integration: https://snappygiftz.com/api/integrations/google-drive/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===================================================
# Google Drive Cloud Storage Integration
# ===================================================
# AES-256-GCM symmetric encryption key for OAuth tokens (generate via `openssl rand -base64 32`)
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=""
