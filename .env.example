# ===================================================
# Snappy Gifts — Environment Variable Configuration
# IMPORTANT: Never commit real secrets or production keys.
# Copy this file to .env for local development / Hostinger deployment.
# ===================================================

# Application Environment
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Target MySQL Database (Hostinger / Local MySQL 8+)
# Hostinger Remote MySQL port is strictly 3306
DATABASE_URL="mysql://u285517860_snappyadmin:YOUR_MYSQL_PASSWORD@srv2204.hstgr.io:3306/u285517860_snappygiftz"
DIRECT_URL="postgresql://snappy_user:snappy_dev_password_only@localhost:5432/snappy_gifts_db?schema=public"

# Auth.js / NextAuth & Custom Session Secret (Generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET="dev_insecure_secret_for_local_development_only_replace_in_prod"
SESSION_SECRET="dev_insecure_secret_for_local_development_only_replace_in_prod"
NEXTAUTH_URL="http://localhost:3000"

# Protected Administrator Account
ADMIN_EMAIL="info@snappygiftz.com"
# ADMIN_BOOTSTRAP_PASSWORD="YourSecureAdminPassword123"

# Razorpay Payment Gateway — exact names required on Hostinger (no quotes in hPanel values)
# Dashboard: Settings → API Keys (Key ID + Key Secret)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_api_secret_from_razorpay"
# Webhooks only (checkout works without this; add for payment.captured events):
# Dashboard: Settings → Webhooks → secret for https://snappygiftz.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# Courier tracking webhook (Shiprocket: Settings → API → Webhooks)
# URL: https://snappygiftz.com/api/webhooks/courier-tracking
# Put the same random value in Shiprocket's "Token" field (sent as the x-api-key header).
# Generate via `openssl rand -hex 24`. Without it, courier updates are rejected (401).
COURIER_WEBHOOK_TOKEN=""

# Transactional Email (Hostinger Titan / Custom SMTP / Mailpit)
# For Hostinger Titan: smtp.hostinger.com (Port 465 with SSL, or 587 with STARTTLS)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="info@snappygiftz.com"
SMTP_PASSWORD="YOUR_HOSTINGER_EMAIL_PASSWORD"
SMTP_FROM_EMAIL="info@snappygiftz.com"
SMTP_FROM_NAME="SNAPPY GIFTZ"
EMAIL_FROM="info@snappygiftz.com"
# Send outbox emails immediately after enqueue (set false to use cron/admin process only)
EMAIL_AUTO_DISPATCH="true"
# Comma-separated admin alert inboxes
ADMIN_EMAILS="info@snappygiftz.com,onebridgeinfotech@gmail.com,ezonetechnologies2124@gmail.com"

# Meta WhatsApp Cloud API (optional — floating wa.me button works without this)
WHATSAPP_GRAPH_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# WhatsApp Direct Concierge (Direct wa.me chat to business/admin phone)
WHATSAPP_ADMIN_NOTIFY_PHONE="8885486999"
WHATSAPP_LOCAL_MOCK="false"

# Internal Security & Worker Crons
CRON_SECRET="snappy_cron_secret_worker_64char_key"
INTERNAL_WORKER_SECRET="snappy_internal_worker_secret_key"

# Business & Tax Origin State (Telangana = 36)
SUPPLIER_GST_STATE_CODE="36"

# Distributed Rate Limiting & Abuse Prevention (Upstash Redis)
# In dev/single-node, defaults to memory adapter; upstash for serverless clusters
RATE_LIMIT_BACKEND="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional GSTIN override (if different from database seller configuration)
SELLER_GSTIN=""

# ===================================================
# Google OAuth & Customer Authentication
# ===================================================
# Web application client credentials from Google Cloud Console ("SNAPPY GIFTZ PRODUCTION")
# Authorized redirect URIs:
#   Customer Sign-In: https://snappygiftz.com/api/auth/google/callback
#   Drive Integration: https://snappygiftz.com/api/integrations/google-drive/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional aliases (same values as above if using one OAuth client):
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://snappygiftz.com/api/auth/google/callback"
# On Hostinger this is often used for the Drive OAuth callback (legacy naming):
GOOGLE_REDIRECT_URI="https://snappygiftz.com/api/integrations/google-drive/callback"

# Dedicated Drive OAuth client (optional — defaults to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET):
GOOGLE_DRIVE_REDIRECT_URI="https://snappygiftz.com/api/integrations/google-drive/callback"
# GOOGLE_DRIVE_CLIENT_ID=""
# GOOGLE_DRIVE_CLIENT_SECRET=""

# Browser / Picker API key (Google Cloud Console → APIs → Credentials → API key)
# Restrict key to Google Picker API + your production domain. Code reads PICKER first, then API_KEY alias.
GOOGLE_PICKER_API_KEY=""
GOOGLE_API_KEY=""

# Optional: shipping distance (Distance Matrix). Omit to use PIN-code heuristics only.
# GOOGLE_MAPS_API_KEY=""

# ===================================================
# Google Drive Cloud Storage Integration
# ===================================================
# AES-256-GCM symmetric encryption key for OAuth tokens (generate via `openssl rand -base64 32`)
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=""
# Pre-configured Google Drive Folder Hierarchy IDs:
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
GOOGLE_DRIVE_PRODUCT_IMAGES_FOLDER_ID=""
GOOGLE_DRIVE_CUSTOMER_PHOTOS_FOLDER_ID=""
GOOGLE_DRIVE_ORDER_ATTACHMENTS_FOLDER_ID=""
GOOGLE_DRIVE_INVOICES_FOLDER_ID=""

