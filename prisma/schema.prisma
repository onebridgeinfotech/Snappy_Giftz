// SNAPPY GIFTZ — Authoritative Prisma Schema
// Target Database: MySQL 8+
// Monetary Invariant: All financial amounts stored strictly as integer paise (BigInt / Int). Zero floating-point arithmetic.
// Architecture: Consumer E-Commerce (Corporate/B2B models completely removed).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================
// ENUMS
// =============================================================

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  PENDING_COD_CONFIRMATION
  CONFIRMED
  PROCESSING
  IN_CUSTOMIZATION
  QUALITY_CHECK
  OUT_FOR_DELIVERY
  DISPATCHED
  DELIVERED
  CANCELLED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum InventoryAdjustmentReason {
  RESTOCK
  MANUAL_CORRECTION
  DAMAGE_WRITE_OFF
  RETURN_RESTOCK
  ORDER_RESERVATION
  RESERVATION_EXPIRED
  ORDER_FULFILLMENT
  AUDIT_RECONCILIATION
}

// =============================================================
// AUTHENTICATION & USERS
// =============================================================

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  phone                String?
  name                 String
  passwordHash         String?
  role                 Role                  @default(CUSTOMER)
  isEmailVerified      Boolean               @default(false)
  isActive             Boolean               @default(true)
  addresses            Address[]
  orders               Order[]
  sessions             Session[]
  otpChallenges        OtpChallenge[]
  auditLogs            AuditLog[]
  inventoryAdjustments InventoryAdjustment[]
  artworkUploads       ArtworkUpload[]
  carts                Cart[]
  webAuthnCredentials  WebAuthnCredential[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([email])
  @@index([role])
}

/** WebAuthn passkeys — Face ID / Touch ID (iOS) and fingerprint / face unlock (Android). */
model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique @db.VarChar(512)
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String?   @db.VarChar(32)
  backedUp     Boolean   @default(false)
  transports   Json      @default("[]")
  nickname     String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id @default(uuid())
  userId    String?
  challenge String   @db.VarChar(512)
  type      String   @db.VarChar(32)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([challenge])
  @@index([expiresAt])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([sessionToken])
  @@index([userId])
}

model OtpChallenge {
  id          String   @id @default(uuid())
  email       String
  otpHash     String
  purpose     String   @default("LOGIN") // "LOGIN", "REGISTER", "PASSWORD_RESET"
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  isUsed      Boolean  @default(false)
  expiresAt   DateTime
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([email, purpose, isUsed])
  @@index([userId])
}

model Address {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  company   String?
  street    String
  city      String
  state     String
  stateCode String   // e.g. "36" for Telangana, "08" for Rajasthan
  pincode   String   // 6-digit Indian PIN code
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pincode])
}

// =============================================================
// CATALOGUE & TAXONOMY
// =============================================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                    String            @id @default(uuid())
  name                  String
  slug                  String            @unique
  tagline               String?
  description           String            @db.Text
  categoryId            String
  category              Category          @relation(fields: [categoryId], references: [id])
  productType           String            @default("REGULAR") // "REGULAR" | "CUSTOMIZABLE"
  occasions             Json?             // Array of occasion slug strings e.g. ["birthday", "anniversary"]
  recipients            Json?             // Array of recipient tags e.g. ["for-her", "couples"]
  hsnCode               String            // e.g. "69120010"
  taxRatePercent        Int               @default(18) // GST %
  isTaxInclusive        Boolean           @default(false)
  basePricePaise        Int               // Base selling price in integer paise
  mrpPaise              Int               // Maximum retail price in integer paise
  costPricePaise        Int?              // Manufacturing / procurement cost in integer paise
  isCustomizable        Boolean           @default(false)
  customizationType     String?           // "engraving" | "photo" | "combo"
  customizationFeePaise Int               @default(0)
  customizationConfig   Json?             // Form configuration / validation rules
  minOrderQty           Int               @default(1)
  images                Json?             // Array of image URL strings
  galleryImages         ProductImage[]
  productOccasions      ProductOccasion[]
  isActive              Boolean           @default(true)
  isArchived            Boolean           @default(false)
  variants              ProductVariant[]
  bulkTiers             BulkTier[]
  cartItems             CartItem[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([productType])
  @@index([isActive])
}

model Occasion {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  description String?           @db.Text
  imageUrl    String?
  isActive    Boolean           @default(true)
  products    ProductOccasion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ProductOccasion {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productId, occasionId])
  @@index([occasionId])
  @@index([productId])
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  storageKey   String?
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([productId, displayOrder])
}

model ProductVariant {
  id                   String                @id @default(uuid())
  productId            String
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                  String                @unique
  name                 String
  attributes           Json
  pricePaise           Int                   // Integer Paise
  stockQuantity        Int                   @default(0)
  isActive             Boolean               @default(true)
  isArchived           Boolean               @default(false)
  orderItems           OrderItem[]
  cartItems            CartItem[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([sku])
  @@index([productId])
}

model InventoryAdjustment {
  id            String                    @id @default(uuid())
  variantId     String
  variant       ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sku           String
  productName   String?
  previousStock Int
  adjustedQty   Int                       // Signed delta: +50, -10
  newStock      Int                       // Balance after adjustment
  reason        InventoryAdjustmentReason @default(MANUAL_CORRECTION)
  referenceId   String?                   // e.g. Order ID, PO number
  userId        String?
  user          User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes         String?                   @db.Text
  createdAt     DateTime                  @default(now())

  @@index([variantId])
  @@index([createdAt])
  @@index([reason])
  @@index([userId])
}

model BulkTier {
  id                 String  @id @default(uuid())
  productId          String
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty             Int
  maxQty             Int?
  discountPercentage Int
  pricePerUnitPaise  Int     // Paise

  @@index([productId])
}

// =============================================================
// PERSISTENT CART SYSTEM
// =============================================================

model Cart {
  id           String     @id @default(uuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([sessionToken])
}

model CartItem {
  id                String          @id @default(uuid())
  cartId            String
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity          Int             @default(1)
  isCustomized      Boolean         @default(false)
  customizationData Json?           // In-cart customization notes, text, etc.
  uploads           ArtworkUpload[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

// =============================================================
// ORDERS & CHECKOUT ENGINE
// =============================================================

model Order {
  id                      String               @id @default(uuid())
  orderNumber             String               @unique // e.g. "SG-2026-10492"
  userId                  String?
  user                    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName            String
  customerEmail           String
  customerPhone           String
  gstin                   String?
  shippingAddress         Json
  destinationStateCode    String

  // Financial Totals in Integer Paise
  itemsSubtotalPaise      BigInt
  customizationTotalPaise BigInt               @default(0)
  discountTotalPaise      BigInt               @default(0)
  taxableAmountPaise      BigInt
  taxTotalPaise           BigInt
  cgstPaise               BigInt               @default(0)
  sgstPaise               BigInt               @default(0)
  igstPaise               BigInt               @default(0)
  shippingTotalPaise      BigInt               @default(0)
  grandTotalPaise         BigInt

  orderStatus             OrderStatus          @default(PENDING)
  paymentStatus           PaymentStatus        @default(PENDING)
  paymentMethod           String               // "RAZORPAY" | "COD"

  idempotencyKey          String?              @unique
  reservationExpiresAt    DateTime?
  guestLookupToken        String?
  fulfillmentMethod       String               @default("DELIVERY") // "DELIVERY" | "STORE_PICKUP"
  shippingPincode         String?
  deliveryFeeRuleId       String?
  notes                   String?              @db.Text
  cancellationReason      String?              @db.Text
  cancelledAt             DateTime?
  cancelledBy             String?

  // Store Pickup Verification
  pickupOtpHash           String?
  pickupOtpExpiresAt      DateTime?
  pickupVerifiedAt        DateTime?
  pickupVerifiedBy        String?

  items                   OrderItem[]
  payments                Payment[]
  shipments               Shipment[]
  statusHistory           OrderStatusHistory[]
  invoices                Invoice[]
  codCollection           CodCollectionRecord?
  refunds                 RefundRecord[]
  deliveryRecord          DeliveryRecord?

  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([reservationExpiresAt])
  @@index([shippingPincode])
  @@index([userId])
}

model OrderItem {
  id                    String                @id @default(uuid())
  orderId               String
  order                 Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId             String?
  variant               ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Historical Snapshot (Preserves immutable record at purchase)
  productName           String
  sku                   String
  hsnCode               String
  taxRatePercent        Int
  unitPricePaise        Int
  quantity              Int
  subtotalPaise         BigInt

  isCustomized          Boolean               @default(false)
  customizationNote     String?               @db.Text
  customizationFeePaise Int                   @default(0)
  proofImageUrl         String?
  customizationMeta     Json?
  personalization       OrderPersonalization?
  uploads               ArtworkUpload[]

  createdAt             DateTime              @default(now())

  @@index([orderId])
  @@index([variantId])
}

// =============================================================
// PAYMENTS, COD & REFUNDS
// =============================================================

model Payment {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway          String         // "RAZORPAY" | "COD" | "MOCK"
  gatewayOrderId   String
  gatewayPaymentId String?
  gatewaySignature String?
  amountPaise      BigInt
  currency         String         @default("INR")
  status           PaymentStatus  @default(PENDING)
  capturedAt       DateTime?
  errorMessage     String?        @db.Text
  idempotencyKey   String?        @unique
  rawEventPayload  Json?
  refunds          RefundRecord[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orderId])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([status])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  gateway     String   // "RAZORPAY"
  eventId     String   @unique
  eventType   String   // "payment.captured", "payment.failed", "order.paid"
  payloadHash String   // SHA-256 of raw request body
  status      String   @default("PROCESSED") // "PROCESSED", "IGNORED", "FAILED", "RECONCILIATION_REQUIRED"
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@index([createdAt])
}

model PaymentReconciliation {
  id                  String   @id @default(uuid())
  orderId             String?
  orderNumber         String?
  gatewayPaymentId    String
  gatewayOrderId      String?
  expectedAmountPaise BigInt?
  receivedAmountPaise BigInt
  discrepancyType     String   // "LATE_PAYMENT_EXPIRED_HOLD", "AMOUNT_MISMATCH", "UNKNOWN_ORDER", "UNAUTHORIZED_CURRENCY"
  status              String   @default("OPEN") // "OPEN", "RESOLVED", "REFUNDED"
  notes               String?  @db.Text
  rawEvent            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([gatewayPaymentId])
  @@index([orderNumber])
  @@index([status])
}

model CodCollectionRecord {
  id                   String   @id @default(uuid())
  orderId              String   @unique
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCollectedPaise BigInt
  collectedAt          DateTime @default(now())
  collectedBy          String   // Courier / staff / owner identifier
  collectionMethod     String   @default("CASH") // "CASH", "UPI_ON_DELIVERY"
  receiptNumber        String?
  notes                String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([orderId])
  @@index([collectedAt])
}

model RefundRecord {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId       String?
  payment         Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amountPaise     BigInt
  reason          String        @db.Text
  status          String        @default("PENDING") // "PENDING", "PROCESSED", "FAILED"
  gatewayRefundId String?       // Razorpay refund ID e.g. "rfnd_..."
  processedBy     String?       // Admin user ID
  idempotencyKey  String?       @unique
  failureReason   String?       @db.Text
  rawResponse     Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([paymentId])
  @@index([gatewayRefundId])
  @@index([status])
}

// =============================================================
// HYDERABAD DELIVERY SYSTEM
// =============================================================

model DeliveryZone {
  id        String               @id @default(uuid())
  code      String               @unique // e.g. "HYD_CENTRAL", "HYD_WEST", "HYD_EAST"
  name      String
  city      String               @default("Hyderabad")
  state     String               @default("Telangana")
  stateCode String               @default("36")
  isActive  Boolean              @default(true)
  pincodes  ServiceablePincode[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ServiceablePincode {
  id           String        @id @default(uuid())
  pincode      String        @unique // 6-digit Indian PIN code
  areaName     String?
  city         String        @default("Hyderabad")
  state        String        @default("Telangana")
  stateCode    String        @default("36")
  zoneId       String?
  zone         DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  isActive     Boolean       @default(true)
  deliveryDays Int           @default(1)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([zoneId])
  @@index([pincode])
  @@index([isActive])
}

/// Studio / delivery hub location and delivery radius (single row, id "default").
/// Edited in Admin > Tax & Delivery. Distances and charges are measured from this point.
model DeliverySettings {
  id            String   @id @default("default")
  hubName       String   @default("SNAPPY GIFTZ Studio")
  hubAddress    String   @db.Text
  hubPincode    String
  hubLatitude   Float
  hubLongitude  Float
  maxRadiusKm   Int      @default(20)
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

/// Automatic delivery charge by distance from the studio: the first active slab whose
/// maxDistanceKm >= the delivery distance sets the fee. Edited in Admin > Settings.
model DeliveryFeeSlab {
  id            String   @id @default(uuid())
  maxDistanceKm Int      // inclusive upper bound, e.g. 10 = "up to 10 km"
  feePaise      BigInt
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedBy     String?

  @@index([isActive, maxDistanceKm])
}

model DeliveryFeeRule {
  id                  String   @id @default(uuid())
  name                String   // e.g. "Free delivery above Rs 999", "Standard delivery"
  minOrderAmountPaise BigInt   @default(0)
  maxOrderAmountPaise BigInt?
  feePaise            BigInt   @default(0)
  priority            Int      @default(0) // Higher priority evaluated first
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([isActive, priority])
}

model DeliveryRecord {
  id                String    @id @default(uuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedPerson    String?   // Owner or designated delivery associate
  assignedPhone     String?
  deliveryStatus    String    @default("ASSIGNED") // "ASSIGNED", "OUT_FOR_DELIVERY", "DELIVERED", "FAILED"
  deliveryNotes     String?   @db.Text
  startedAt         DateTime?
  deliveredAt       DateTime?
  recipientName     String?
  recipientPhone    String?
  codAmountDuePaise BigInt    @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([orderId])
  @@index([deliveryStatus])
}

model Shipment {
  id                        String    @id @default(uuid())
  orderId                   String
  order                     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipientName             String
  recipientEmail            String?
  recipientPhone            String
  addressStreet             String
  city                      String
  state                     String
  pincode                   String
  carrierPartner            String?
  awbNumber                 String?   @unique
  trackingUrl               String?
  dispatchStatus            String    @default("PENDING")
  dispatchedAt              DateTime?
  deliveredAt               DateTime?
  invoicePhysicallySignedBy String?
  invoicePhysicallySignedAt DateTime?
  trackingEvents            ShipmentTrackingEvent[]
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([orderId])
  @@index([awbNumber])
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus
  toStatus   OrderStatus
  changedBy  String
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())

  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// =============================================================
// CUSTOMIZATION & PRIVATE UPLOADS
// Max 3 images per customized item, max 10MB per image
// =============================================================

model ArtworkUpload {
  id                String                 @id @default(uuid())
  fileKey           String                 @unique // Storage identifier: "customizations/uuid.jpg"
  originalFilename  String
  mimeType          String
  sizeBytes         Int
  fileHash          String?                // SHA-256 hash of raw binary buffer
  storageFolder     String                 @default("customizations")
  cartItemId        String?
  cartItem          CartItem?              @relation(fields: [cartItemId], references: [id], onDelete: SetNull)
  orderItemId       String?
  orderItem         OrderItem?             @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  uploadedByUserId  String?
  user              User?                  @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  guestSessionToken String?
  status            String                 @default("ACTIVE") // "ACTIVE", "ATTACHED", "ABANDONED"
  expiresAt         DateTime?
  personalizations  OrderPersonalization[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([fileKey])
  @@index([cartItemId])
  @@index([orderItemId])
  @@index([uploadedByUserId])
  @@index([guestSessionToken])
  @@index([status])
}

model OrderPersonalization {
  id                     String         @id @default(uuid())
  orderItemId            String         @unique
  orderItem              OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  personalizationType    String         @default("TEXT_ENGRAVING") // "TEXT_ENGRAVING", "PHOTO_PRINT", "BESPOKE_COMBO"
  engravedText           String?
  fontFamily             String?
  giftNote               String?
  ribbonColor            String?
  boxWrapStyle           String?
  waxSealColor           String?
  artworkUploadId        String?
  artworkUpload          ArtworkUpload? @relation(fields: [artworkUploadId], references: [id], onDelete: SetNull)
  cropSettings           Json?
  placementSettings      Json?
  proofImageUrl          String?
  proofAssetKey          String?
  proofVersion           Int            @default(1)
  approvalStatus         String         @default("APPROVED_BY_CUSTOMER")
  approvedAt             DateTime?
  approvedBy             String?
  customerApprovalStatus String         @default("PENDING")
  customerApprovedAt     DateTime?
  customerApprovedBy     String?
  staffReviewStatus      String         @default("PENDING_REVIEW")
  staffReviewedAt        DateTime?
  staffReviewedBy        String?
  customizationFeePaise  Int            @default(0)
  staffNotes             String?        @db.Text
  metadata               Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([orderItemId])
  @@index([artworkUploadId])
  @@index([approvalStatus])
  @@index([customerApprovalStatus])
  @@index([staffReviewStatus])
}

// =============================================================
// INVOICING & GST COMPLIANCE
// =============================================================

model Invoice {
  id                           String    @id @default(uuid())
  invoiceNumber                String    @unique // e.g. "SG/26-27/0001"
  orderId                      String
  order                        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber                  String
  invoiceDate                  DateTime  @default(now())
  financialYear                String    // e.g. "2026-27"
  series                       String    @default("SG")
  sequenceNumber               Int

  // Supplier Snapshot
  supplierLegalName            String
  supplierTradeName            String?
  supplierGstin                String
  supplierAddress              Json
  supplierState                String
  supplierStateCode            String

  // Recipient Snapshot
  customerName                 String
  customerEmail                String
  customerPhone                String?
  customerGstin                String?
  billingAddress               Json
  shippingAddress              Json
  placeOfSupply                String
  placeOfSupplyStateCode       String
  isIntraState                 Boolean

  // Financial Snapshot in Integer Paise
  itemsSubtotalPaise           BigInt
  customizationTotalPaise      BigInt    @default(0)
  discountTotalPaise           BigInt    @default(0)
  taxableAmountPaise           BigInt
  cgstPaise                    BigInt    @default(0)
  sgstPaise                    BigInt    @default(0)
  igstPaise                    BigInt    @default(0)
  taxTotalPaise                BigInt
  shippingTotalPaise           BigInt    @default(0)
  grandTotalPaise              BigInt

  itemsJson                    Json
  pdfStorageKey                String?
  pdfGeneratedAt               DateTime?
  isSample                     Boolean   @default(false)
  status                       String    @default("ISSUED") // "ISSUED", "CANCELLED", "PROVISIONAL"

  eInvoiceStatus               String    @default("EXEMPT_BELOW_THRESHOLD")
  irn                          String?
  signedQrData                 String?   @db.Text
  rule46Declaration            String?   @db.Text
  signatureMode                String    @default("PHYSICAL_SIGNATURE_ON_PRINT")
  physicalSignatureConfirmedBy String?
  physicalSignatureConfirmedAt DateTime?

  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@unique([financialYear, series, sequenceNumber])
  @@index([orderId])
  @@index([orderNumber])
  @@index([financialYear])
}

model InvoiceSequence {
  id              String   @id @default(uuid())
  financialYear   String
  series          String   @default("SG")
  currentSequence Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([financialYear, series])
}

// =============================================================
// EMAIL NOTIFICATIONS (OUTBOX PATTERN)
// =============================================================

model EmailOutbox {
  id                 String    @id @default(uuid())
  idempotencyKey     String    @unique
  eventType          String    // "ORDER_CONFIRMATION", "OWNER_NEW_ORDER", "COD_APPROVED", "COD_REJECTED", "SHIPMENT_DISPATCHED", "INVOICE_AVAILABLE"
  orderId            String?
  orderNumber        String?
  recipientEmail     String
  recipientName      String?
  subject            String
  htmlBody           String    @db.Text
  textBody           String?   @db.Text
  attachmentKey      String?
  attachmentFilename String?
  status             String    @default("PENDING") // "PENDING", "PROCESSING", "SENT", "FAILED"
  attempts           Int       @default(0)
  maxAttempts        Int       @default(5)
  lastError          String?   @db.Text
  nextRetryAt        DateTime?
  lockedAt           DateTime?
  lockedBy           String?
  sentAt             DateTime?
  messageId          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([orderNumber])
  @@index([idempotencyKey])
}

// =============================================================
// BUSINESS CONFIGURATION & SETTINGS
// =============================================================

model SellerConfig {
  id                                           String    @id @default("default")
  legalName                                    String
  tradeName                                    String?
  gstin                                        String
  pan                                          String?
  registeredStreet                             String
  city                                         String
  state                                        String    @default("Telangana")
  stateCode                                    String    @default("36")
  pincode                                      String
  contactEmail                                 String
  contactPhone                                 String
  invoicePrefix                                String    @default("SG")
  authorizedSignatoryName                      String?
  authorizedSignatoryDesignation               String?
  invoiceFooterTerms                           String?   @db.Text
  isVerified                                   Boolean   @default(false)

  eInvoiceStatus                               String    @default("EXEMPT_BELOW_THRESHOLD")
  eInvoiceExemptionReason                      String?
  eInvoiceConfirmedBy                          String?
  eInvoiceConfirmedAt                          DateTime?
  panAggregateTurnoverExceeds5Cr               Boolean   @default(false)

  signatureMode                                String    @default("PHYSICAL_SIGNATURE_ON_PRINT")
  digitalSignatureConfigured                   Boolean   @default(false)
  electronicInvoiceSignatureExemptionConfirmed Boolean   @default(false)
  electronicInvoiceExemptionConfirmedBy        String?
  electronicInvoiceExemptionConfirmedAt        DateTime?

  updatedAt                                    DateTime  @updatedAt
  updatedBy                                    String?
}

model StoreConfig {
  id                         String   @id @default("default")
  storeName                  String   @default("SNAPPY GIFTZ")
  supportEmail               String   @default("support@snappygiftz.com")
  supportPhone               String   @default("+91 90000 00000")
  operatingHours             String   @default("Mon-Sat 10:00 AM - 8:00 PM IST")
  headquartersAddress        String   @default("Hyderabad, Telangana - 500001")

  // Delivery Configuration (Paise)
  standardShippingFeePaise   BigInt   @default(9900)
  freeShippingThresholdPaise BigInt   @default(99900)
  expressShippingFeePaise    BigInt   @default(19900)
  shippingInstructions       String?  @db.Text

  // Inventory Alert Thresholds
  lowStockThreshold          Int      @default(10)
  outOfStockThreshold        Int      @default(0)
  autoNotifyLowStock         Boolean  @default(true)

  // Personalization Configuration
  allowCustomText            Boolean  @default(true)
  allowArtworkUpload         Boolean  @default(true)
  maxArtworkUploadBytes      Int      @default(10485760) // 10 MB
  woodenCrateSurchargePaise  BigInt   @default(15000)

  updatedAt                  DateTime @updatedAt
  updatedBy                  String?
}

// =============================================================
// GOOGLE DRIVE CLOUD STORAGE INTEGRATION
// =============================================================

model GoogleDriveIntegration {
  id                       String    @id @default("default")
  isConnected              Boolean   @default(false)
  accountEmail             String?
  encryptedRefreshToken    String?   @db.Text
  encryptedAccessToken     String?   @db.Text
  accessTokenExpiresAt     DateTime?
  rootFolderId             String?   // SNAPPY_GIFTZ_STORAGE
  productImagesFolderId    String?   // Product_Images
  customerPhotosFolderId   String?   // Customer_Personalization_Photos
  orderAttachmentsFolderId String?   // Order_Attachments
  invoicesFolderId         String?   // Invoices
  connectedBy              String?   // Admin User ID
  connectedAt              DateTime?
  lastSyncedAt             DateTime?
  lastError                String?   @db.Text
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

/// Courier scan / status updates pushed by the courier (e.g. Shiprocket webhook).
/// Shown to the customer as the tracking timeline; dedupeKey makes webhook retries harmless.
model ShipmentTrackingEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderId     String
  awbNumber   String
  status      String   // Normalized: IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RTO, FAILED_ATTEMPT, PICKED_UP, OTHER
  rawStatus   String?  // Courier's own label, e.g. "Reached at Destination Hub"
  activity    String?  @db.Text
  location    String?
  eventAt     DateTime
  source      String   @default("COURIER_WEBHOOK")
  dedupeKey   String   @unique
  createdAt   DateTime @default(now())

  @@index([orderId, eventAt])
  @@index([awbNumber])
}
